# Todo es opcional. Sin variables, el sitio funciona con búsqueda léxica y respuestas extractivas.

# Respuestas redactadas con Claude (Netlify)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_QA=claude-haiku-4-5-20251001

# Búsqueda semántica con pgvector (Netlify: usuario de SOLO LECTURA)
DATABASE_URL_READONLY=
VOYAGE_API_KEY=

# Solo en tu máquina o GitHub Actions (escritura): carga del corpus
DATABASE_URL_ADMIN=
CLAUDE_MODEL_BATCH=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# Analítica propia y panel /admin (todo opcional: sin estas variables no se registra nada)
# Generar los secretos con: node scripts/admin-setup.mjs   (no escribe en disco)

# Rol analytics_writer (INSERT/UPDATE en visitas_sesion): /api/visita, login y purga diaria
DATABASE_URL_ANALYTICS=
# Rol analytics_reader (solo SELECT en visitas_sesion): /api/admin/visitas
DATABASE_URL_ANALYTICS_READER=
# Sal del HMAC de la IP (se combina con la fecha de Lima). Si falta, /api/visita no guarda nada
ANALYTICS_SALT=

# Hash scrypt de la contraseña, formato scrypt$N$r$p$sal$hash. En .env local va entre comillas simples
ADMIN_PASSWORD_HASH=
# Secreto TOTP en base32 (app autenticadora, 6 dígitos, 30 s)
ADMIN_TOTP_SECRET=
# Firma HMAC de la cookie de sesión (mín. 32 caracteres). Rotarlo cierra todas las sesiones
ADMIN_SESSION_SECRET=
